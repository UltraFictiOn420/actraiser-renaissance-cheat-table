        <CheatEntry>
          <ID>25</ID>
          <Description>"Teleport to Nearest Gold Scroll (J Hotkey - Last Result: READY)"</Description>
          <VariableType>Auto Assembler Script</VariableType>
          <AssemblerScript>[ENABLE]
{$lua}
if syntaxcheck then return end

local function ActraiserScrollReadPointer(address)
  if not address or address == 0 then return nil end
  -- Actraiser Renaissance is 64-bit. Avoid dependence on CE's current
  -- pointer-size setting by reading every managed pointer explicitly.
  local ok, value = pcall(readQword, address)
  if ok and value and value ~= 0 then return value end
  return nil
end

local function ActraiserScrollReadInteger(address)
  if not address or address == 0 then return nil end
  local ok, value = pcall(readInteger, address)
  if ok then return value end
  return nil
end

local function ActraiserScrollReadFloat(address)
  if not address or address == 0 then return nil end
  local ok, value = pcall(readFloat, address)
  if ok then return value end
  return nil
end

local function ActraiserScrollManagedString(address)
  if not address or address == 0 then return nil end
  local length = ActraiserScrollReadInteger(address + 0x10)
  if not length or length &lt;= 0 or length &gt; 256 then return nil end

  -- IL2CPP System.String stores UTF-16LE characters at +14. CE's wide
  -- readString conversion was returning no usable names on this game, so
  -- decode the ASCII object identifiers directly from their UTF-16 bytes.
  local ok, bytes = pcall(readBytes, address + 0x14, length * 2, true)
  if not ok or type(bytes) ~= 'table' then return nil end

  local characters = {}
  for index = 1, length * 2, 2 do
    local low = bytes[index]
    local high = bytes[index + 1]
    if low == nil or high == nil or high ~= 0 or low &gt; 127 then
      return nil
    end
    characters[#characters + 1] = string.char(low)
  end
  return table.concat(characters)
end

function ActraiserTeleportNearestGoldScroll()
  local gamePid = getProcessIDFromProcessName('ActraiserR.exe')
  if not gamePid or gamePid == 0 then
    return false, 'ActraiserR.exe is not running'
  end

  if getOpenedProcessID() ~= gamePid then
    local attached = pcall(openProcess, gamePid)
    if not attached then
      return false, 'Cheat Engine could not attach to ActraiserR.exe'
    end
    pcall(reinitializeSymbolhandler, true)
  end

  local moduleBase = getAddressSafe('GameAssembly.dll')
  if not moduleBase or moduleBase == 0 then
    local modulesOk, modules = pcall(enumModules, gamePid)
    if modulesOk and modules then
      for _, module in ipairs(modules) do
        if module.Name and string.lower(module.Name) == 'gameassembly.dll' then
          moduleBase = module.Address
          break
        end
      end
    end
  end
  if not moduleBase or moduleBase == 0 then
    return false, 'GameAssembly.dll is not available'
  end

  -- Resolve SceneAct.AcssInstance.playerAObj.
  local sceneClass = ActraiserScrollReadPointer(moduleBase + 0x16A3788)
  local sceneStatic = sceneClass and ActraiserScrollReadPointer(sceneClass + 0xB8)
  local scene = sceneStatic and ActraiserScrollReadPointer(sceneStatic + 0x50)
  local player = scene and ActraiserScrollReadPointer(scene + 0xC0)
  if not player then
    return false, 'The Act Mode player is not active.'
  end

  local playerX = ActraiserScrollReadFloat(player + 0xCC)
  local playerY = ActraiserScrollReadFloat(player + 0xD0)
  if not playerX or not playerY then
    return false, 'The live player position could not be read.'
  end

  -- Resolve ACTOLObjectManager.objectDictinary and its IL2CPP entry array.
  local managerClass = ActraiserScrollReadPointer(moduleBase + 0x16A37B8)
  local managerStatic = managerClass and ActraiserScrollReadPointer(managerClass + 0xB8)
  local manager = managerStatic and ActraiserScrollReadPointer(managerStatic)
  local dictionary = manager and ActraiserScrollReadPointer(manager + 0x10)
  local entries = dictionary and ActraiserScrollReadPointer(dictionary + 0x18)
  local capacity = entries and ActraiserScrollReadInteger(entries + 0x18)
  if not capacity or capacity &lt;= 0 or capacity &gt; 4096 then
    return false, 'The current Act Mode object registry is unavailable.'
  end

  local nearestObject = nil
  local nearestDistance = math.huge
  for index = 0, capacity - 1 do
    local entry = entries + 0x20 + index * 0x18
    local hashCode = ActraiserScrollReadInteger(entry)
    local object = ActraiserScrollReadPointer(entry + 0x10)
    if hashCode and hashCode &gt;= 0 and object then
      local objectCore = ActraiserScrollReadPointer(object + 0x58)
      local nameObject = objectCore and ActraiserScrollReadPointer(objectCore + 0x10)
      local coreName = nameObject and ActraiserScrollManagedString(nameObject)
      local objectSetting = objectCore and ActraiserScrollReadPointer(objectCore + 0x18)
      local animationObject = objectSetting and ActraiserScrollReadPointer(objectSetting + 0x10)
      local animationName = animationObject and ActraiserScrollManagedString(animationObject)

      -- Accept the gold identifier from either the core or animation record.
      local isGoldCore = coreName and string.find(coreName, 'act_gmk_ITEMSTATUE_GOLD', 1, true) == 1
      local isGoldAnimation = animationName and string.find(animationName, 'act_gmk_ITEMSTATUE_GOLD', 1, true) == 1
      if isGoldCore or isGoldAnimation then
        local objectX = ActraiserScrollReadFloat(object + 0xCC)
        local objectY = ActraiserScrollReadFloat(object + 0xD0)
        local objectZ = ActraiserScrollReadFloat(object + 0xD4)
        if objectX and objectY and objectZ then
          local dx = objectX - playerX
          local dy = objectY - playerY
          local distance = dx * dx + dy * dy
          if distance &lt; nearestDistance then
            nearestDistance = distance
            nearestObject = { x = objectX, y = objectY, z = objectZ }
          end
        end
      end
    end
  end

  if not nearestObject then
    return false, 'No live gold scroll statue was found in this loaded dungeon section.'
  end

  -- Use the game's own SVObject.Teleport method. This updates the live
  -- Rigidbody2D/Transform and clears its velocity; setPosition alone is only
  -- ACTOL's cached coordinate and does not move the visible player.
  local svObject = ActraiserScrollReadPointer(player + 0x78)
  if not svObject then
    return false, 'The live player SVObject is unavailable'
  end

  local vectorBuffer = allocateMemory(16)
  if not vectorBuffer or vectorBuffer == 0 then
    return false, 'Could not allocate the native teleport vector'
  end

  writeFloat(vectorBuffer, nearestObject.x)
  writeFloat(vectorBuffer + 4, nearestObject.y)
  writeFloat(vectorBuffer + 8, nearestObject.z)

  local callOk, callError = pcall(
    executeMethod,
    0,
    2000,
    moduleBase + 0xFCB430,
    { regnr = 1, classinstance = svObject },
    { type = 0, value = vectorBuffer },
    { type = 0, value = 0 }
  )
  pcall(deAlloc, vectorBuffer, 16)
  if not callOk then
    return false, 'The native SVObject.Teleport call failed: ' .. tostring(callError)
  end

  -- Keep ACTOL's cached coordinate synchronized with the native body.
  writeFloat(player + 0xCC, nearestObject.x)
  writeFloat(player + 0xD0, nearestObject.y)
  writeFloat(player + 0xD4, nearestObject.z)
  for offset = 0xD8, 0xEC, 4 do
    writeFloat(player + offset, 0.0)
  end
  return true
end

local teleportRecord = getAddressList().getMemoryRecordByID(25)
local ok, result, message = pcall(ActraiserTeleportNearestGoldScroll)
if ok and result then
  teleportRecord.Description = 'Teleport to Nearest Gold Scroll (J Hotkey - Last Result: SUCCESS)'
else
  local reason = ok and message or result
  teleportRecord.Description = 'Teleport to Nearest Gold Scroll (J Hotkey - ERROR: ' .. tostring(reason) .. ')'
  beep()
end

-- This is a native Cheat Engine table hotkey entry. Return it to the
-- unchecked state after each one-shot activation so J is always ready.
createTimer(100, function()
  if teleportRecord and teleportRecord.Active then
    teleportRecord.Active = false
  end
end)

{$asm}

