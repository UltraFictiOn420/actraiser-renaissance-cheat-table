          <VariableType>Auto Assembler Script</VariableType>
          <AssemblerScript>[ENABLE]
aobscanmodule(ActR_Miracle_GetCooldown,GameAssembly.dll,48 89 5C 24 08 57 48 83 EC 20 80 3D 43 94 33 01 00 8B DA 8B F9 75 12)

// New miracle uses receive a zero-second cooldown.
assert(ActR_Miracle_GetCooldown,48 89 5C 24 08)
ActR_Miracle_GetCooldown:
  db 31 C0 C3 90 90

registersymbol(ActR_Miracle_GetCooldown)

{$lua}
if syntaxcheck then return end

if ActraiserMiracleCooldownTimer then
  ActraiserMiracleCooldownTimer.destroy()
  ActraiserMiracleCooldownTimer = nil
end

ActraiserResolveMiracleRange = function()
  local root = getAddressSafe('GameAssembly.dll+16A0E90')
  if not root then return nil end

  local klass = readPointer(root)
  if not klass or klass == 0 then return nil end

  local staticFields = readPointer(klass + 0xB8)
  if not staticFields or staticFields == 0 then return nil end

  local instance = readPointer(staticFields)
  if not instance or instance == 0 then return nil end
  return instance
end

local function clearActraiserFloatArray(array)
  if not array or array == 0 then return end
  local count = readInteger(array + 0x18)
  if not count or count &lt; 1 then return end
  if count &gt; 16 then count = 16 end
  for i = 0, count - 1 do
    writeFloat(array + 0x20 + i * 4, 0)
  end
end

local function clearActraiserBoolArray(array)
  if not array or array == 0 then return end
  local count = readInteger(array + 0x18)
  if not count or count &lt; 1 then return end
  if count &gt; 16 then count = 16 end
  for i = 0, count - 1 do
    writeBytes(array + 0x20 + i, 0)
  end
end

local function clearActraiserMiracleCooldowns()
  pcall(function()
    local instance = ActraiserResolveMiracleRange()
    if not instance then return end

    clearActraiserBoolArray(readPointer(instance + 0xA8))
    clearActraiserFloatArray(readPointer(instance + 0xB0))
    clearActraiserFloatArray(readPointer(instance + 0xB8))
    clearActraiserFloatArray(readPointer(instance + 0xE0))
    writeBytes(instance + 0xD4, 0)
    writeFloat(instance + 0xD8, 0)
  end)
end

clearActraiserMiracleCooldowns()
ActraiserMiracleCooldownTimer = createTimer(nil, false)
ActraiserMiracleCooldownTimer.Interval = 100
ActraiserMiracleCooldownTimer.OnTimer = clearActraiserMiracleCooldowns
ActraiserMiracleCooldownTimer.Enabled = true

{$asm}

[DISABLE]
{$lua}
if syntaxcheck then return end

if ActraiserMiracleCooldownTimer then
  ActraiserMiracleCooldownTimer.destroy()
  ActraiserMiracleCooldownTimer = nil
end
ActraiserResolveMiracleRange = nil

{$asm}
ActR_Miracle_GetCooldown:
  db 48 89 5C 24 08

unregistersymbol(ActR_Miracle_GetCooldown)
</AssemblerScript>
        </CheatEntry>
        <CheatEntry>
          <ID>18</ID>
          <Description>"Super Forts (Attack + Speed + Range + Defense)"</Description>
          <VariableType>Auto Assembler Script</VariableType>
          <AssemblerScript>[ENABLE]
{$lua}
if syntaxcheck then return end

if ActraiserSuperFortTimer then
  ActraiserSuperFortTimer.destroy()
  ActraiserSuperFortTimer = nil
end

ActraiserSuperFortOriginals = {}

ActraiserResolveFortBuild = function()
  local root = getAddressSafe('GameAssembly.dll+16A29B0')
  if not root then return nil end

  local klass = readPointer(root)
  if not klass or klass == 0 then return nil end

  local staticFields = readPointer(klass + 0xB8)
  if not staticFields or staticFields == 0 then return nil end

  local stage = readPointer(staticFields + 0x38)
  if not stage or stage == 0 then return nil end

  local fortBuild = readPointer(stage + 0x60)
  if not fortBuild or fortBuild == 0 then return nil end
  return fortBuild
end

ActraiserForEachCombatFort = function(callback)
  local fortBuild = ActraiserResolveFortBuild()
  if not fortBuild then return end

  local function walkFortList(list)
    if not list or list == 0 then return end
    local items = readPointer(list + 0x10)
    local count = readInteger(list + 0x18)
    if not items or items == 0 or not count or count &lt; 1 then return end
    if count &gt; 128 then count = 128 end

    for i = 0, count - 1 do
      local fort = readPointer(items + 0x20 + i * 8)
      if fort and fort ~= 0 then
        local param = readPointer(fort + 0x78)
        if param and param ~= 0 then callback(param) end
      end
    end
  end

  -- Gate/defense forts and arrow/magic attack forts; fence list +0x148 is excluded.
  walkFortList(readPointer(fortBuild + 0x138))
  walkFortList(readPointer(fortBuild + 0x140))
end

local function boostActraiserFort(param)
  if not ActraiserSuperFortOriginals[param] then
    ActraiserSuperFortOriginals[param] = {
      atk = readSmallInteger(param + 0x22),
      def = readSmallInteger(param + 0x24),
      mdf = readSmallInteger(param + 0x26),
      resFire = readSmallInteger(param + 0x30),
      resIce = readSmallInteger(param + 0x32),
      atkSpd = readFloat(param + 0x38),
      atkRng = readFloat(param + 0x40),
      atkAng = readSmallInteger(param + 0x44),
      bulletRng = readFloat(param + 0x48),
      targets = readSmallInteger(param + 0x4C)
    }
  end

  writeSmallInteger(param + 0x22, 999)
  writeSmallInteger(param + 0x24, 999)
  writeSmallInteger(param + 0x26, 999)
  writeSmallInteger(param + 0x30, 999)
  writeSmallInteger(param + 0x32, 999)
  writeFloat(param + 0x38, 0.15)
  writeFloat(param + 0x40, 20.0)
  writeSmallInteger(param + 0x44, 360)
  writeFloat(param + 0x48, 20.0)
  writeSmallInteger(param + 0x4C, 20)
end

local function boostAllActraiserForts()
  pcall(function()
    ActraiserForEachCombatFort(boostActraiserFort)
  end)
end

boostAllActraiserForts()
ActraiserSuperFortTimer = createTimer(nil, false)
ActraiserSuperFortTimer.Interval = 100
ActraiserSuperFortTimer.OnTimer = boostAllActraiserForts
ActraiserSuperFortTimer.Enabled = true

{$asm}

[DISABLE]
{$lua}
if syntaxcheck then return end

if ActraiserSuperFortTimer then
  ActraiserSuperFortTimer.destroy()
  ActraiserSuperFortTimer = nil
end

if ActraiserForEachCombatFort and ActraiserSuperFortOriginals then
  pcall(function()
    ActraiserForEachCombatFort(function(param)
      local original = ActraiserSuperFortOriginals[param]
      if not original then return end

      writeSmallInteger(param + 0x22, original.atk)
      writeSmallInteger(param + 0x24, original.def)
      writeSmallInteger(param + 0x26, original.mdf)
      writeSmallInteger(param + 0x30, original.resFire)
      writeSmallInteger(param + 0x32, original.resIce)
      writeFloat(param + 0x38, original.atkSpd)
      writeFloat(param + 0x40, original.atkRng)
      writeSmallInteger(param + 0x44, original.atkAng)
      writeFloat(param + 0x48, original.bulletRng)
      writeSmallInteger(param + 0x4C, original.targets)
    end)
  end)
end

ActraiserSuperFortOriginals = nil
ActraiserForEachCombatFort = nil
ActraiserResolveFortBuild = nil

{$asm}
</AssemblerScript>
