          <AssemblerScript>[ENABLE]
aobscanmodule(ActR_Champion_SetDamage,GameAssembly.dll,48 89 5C 24 08 57 48 83 EC 20 48 8B D9 41 8B F8 48 8B 89 B8 00 00 00 48 85 C9 0F 84 C5 00 00 00)

// CRTHeroBase.SetDamage is exclusive to the player's champions.
// Return before defense calculation, HP loss, hit reactions, or death handling.
assert(ActR_Champion_SetDamage,48 89 5C 24 08)
ActR_Champion_SetDamage:
  db C3 90 90 90 90

registersymbol(ActR_Champion_SetDamage)

{$lua}
