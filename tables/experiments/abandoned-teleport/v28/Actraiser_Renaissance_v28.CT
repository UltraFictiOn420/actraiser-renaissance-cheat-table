        <CheatEntry>
          <ID>20</ID>
          <Description>"All Legendary Chronicles = 999"</Description>
          <VariableType>Auto Assembler Script</VariableType>
          <AssemblerScript>[ENABLE]
{$lua}
if syntaxcheck then return end

if ActraiserAllChroniclesTimer then
  ActraiserAllChroniclesTimer.destroy()
  ActraiserAllChroniclesTimer = nil
end

ActraiserResolveItemArray = function()
  local root = getAddressSafe('GameAssembly.dll+16A34B0')
  if not root then return nil end

  local klass = readPointer(root)
  if not klass or klass == 0 then return nil end

  local staticFields = readPointer(klass + 0xB8)
  if not staticFields or staticFields == 0 then return nil end

  local manager = readPointer(staticFields)
  if not manager or manager == 0 then return nil end

  local saveData = readPointer(manager + 0x30)
  if not saveData or saveData == 0 then return nil end

  local itemArray = readPointer(saveData + 0x38)
  if not itemArray or itemArray == 0 then return nil end
  return itemArray
end

local function setActraiserAllChronicles999()
  local itemArray = ActraiserResolveItemArray()
  if not itemArray then return end

  local itemCount = readInteger(itemArray + 0x18)
  if not itemCount or itemCount &lt;= 30 then return end

  -- Item IDs 25-30 are Philotas, Daniella, Alonso, Migrana, Shemaal, and Taia.
  for itemID = 25, 30 do
    local address = itemArray + 0x20 + itemID * 4
    if ActraiserAllChronicleOriginals[address] == nil then
      ActraiserAllChronicleOriginals[address] = readInteger(address)
    end
    writeInteger(address, 999)
  end
end

ActraiserAllChronicleOriginals = {}
setActraiserAllChronicles999()

ActraiserAllChroniclesTimer = createTimer(nil, false)
ActraiserAllChroniclesTimer.Interval = 100
ActraiserAllChroniclesTimer.OnTimer = setActraiserAllChronicles999
ActraiserAllChroniclesTimer.Enabled = true

{$asm}

[DISABLE]
{$lua}
if syntaxcheck then return end

if ActraiserAllChroniclesTimer then
  ActraiserAllChroniclesTimer.destroy()
  ActraiserAllChroniclesTimer = nil
end

if ActraiserAllChronicleOriginals then
  for address, original in pairs(ActraiserAllChronicleOriginals) do
    pcall(function()
      if readInteger(address) == 999 then
        writeInteger(address, original)
      end
    end)
  end
end

ActraiserAllChronicleOriginals = nil
ActraiserResolveItemArray = nil

{$asm}
</AssemblerScript>
