if ActraiserSuperChampionTimer then
  ActraiserSuperChampionTimer.destroy()
  ActraiserSuperChampionTimer = nil
end

ActraiserSuperChampionOriginals = {}
ActraiserSuperChampionUnitOriginals = {}

ActraiserForEachChampion = function(callback)
  local root = getAddressSafe('GameAssembly.dll+16A1698')
  if not root then return end

  local klass = readPointer(root)
  if not klass or klass == 0 then return end

  local staticFields = readPointer(klass + 0xB8)
  if not staticFields or staticFields == 0 then return end

  local manager = readPointer(staticFields)
  if not manager or manager == 0 then return end

  local heroes = readPointer(manager + 0x98)
  if not heroes or heroes == 0 then return end

  local count = readInteger(heroes + 0x18)
  if not count or count &lt; 1 then return end
  if count &gt; 12 then count = 12 end

  for i = 0, count - 1 do
    local hero = readPointer(heroes + 0x20 + i * 8)
    if hero and hero ~= 0 then
      local unitParam = readPointer(hero + 0xB0)
      local heroParam = readPointer(hero + 0xB8)
      if unitParam and unitParam ~= 0 and heroParam and heroParam ~= 0 then
        callback(heroParam, unitParam)
      end
    end
  end
end

local function boostActraiserChampion(heroParam, unitParam)
  if not ActraiserSuperChampionUnitOriginals[unitParam] then
    ActraiserSuperChampionUnitOriginals[unitParam] = {
      hp = readSmallInteger(unitParam + 0x18),
      atk = readSmallInteger(unitParam + 0x1A),
      def = readSmallInteger(unitParam + 0x1C),
      mdf = readSmallInteger(unitParam + 0x1E),
      resFire = readSmallInteger(unitParam + 0x28),
      resIce = readSmallInteger(unitParam + 0x2A),
      atkSpd = readFloat(unitParam + 0x30),
      atkRng = readSmallInteger(unitParam + 0x36),
      spAtk = readFloat(unitParam + 0x40),
      spRng = readSmallInteger(unitParam + 0x44)
    }
  end

  if not ActraiserSuperChampionOriginals[heroParam] then
    ActraiserSuperChampionOriginals[heroParam] = {
      atk = readSmallInteger(heroParam + 0x20),
      def = readSmallInteger(heroParam + 0x22),
      mdf = readSmallInteger(heroParam + 0x24),
      resFire = readSmallInteger(heroParam + 0x30),
      resIce = readSmallInteger(heroParam + 0x32),
      atkSpd = readFloat(heroParam + 0x38),
      atkRng = readFloat(heroParam + 0x40),
      atkAng = readFloat(heroParam + 0x44),
      spAtk = readFloat(heroParam + 0x50),
      spRng = readFloat(heroParam + 0x54),
      spAng = readFloat(heroParam + 0x58)
    }
  end

  -- This runtime datatable copy also feeds Ally Profiles and newly spawned champions.
  -- Range is stored here in hundredths, so 2000 becomes 20.0 in the combat block.
  writeSmallInteger(unitParam + 0x18, 999)
  writeSmallInteger(unitParam + 0x1A, 999)
  writeSmallInteger(unitParam + 0x1C, 999)
  writeSmallInteger(unitParam + 0x1E, 999)
  writeSmallInteger(unitParam + 0x28, 999)
  writeSmallInteger(unitParam + 0x2A, 999)
  writeFloat(unitParam + 0x30, 0.15)
  writeSmallInteger(unitParam + 0x36, 2000)
  writeFloat(unitParam + 0x40, 10.0)
  writeSmallInteger(unitParam + 0x44, 2000)

  -- Refill the live champion to the now-boosted runtime maximum.
  local maxHP = readSmallInteger(unitParam + 0x18)
  if maxHP and maxHP &gt; 0 then
    writeSmallInteger(heroParam + 0x1E, maxHP)
  end

  -- Deliberately stay inside the native short/float field types.
  writeSmallInteger(heroParam + 0x20, 999)  -- Attack
  writeSmallInteger(heroParam + 0x22, 999)  -- Defense
  writeSmallInteger(heroParam + 0x24, 999)  -- Magic defense
  writeSmallInteger(heroParam + 0x30, 999)  -- Fire resistance
  writeSmallInteger(heroParam + 0x32, 999)  -- Ice resistance
  writeFloat(heroParam + 0x38, 0.15)         -- Attack cooldown (lower is faster)
  writeFloat(heroParam + 0x40, 20.0)         -- Normal attack range
  writeFloat(heroParam + 0x44, 360.0)        -- Normal attack arc
  writeFloat(heroParam + 0x50, 10.0)         -- Special attack power
  writeFloat(heroParam + 0x54, 20.0)         -- Special attack range
  writeFloat(heroParam + 0x58, 360.0)        -- Special attack arc
end

local function boostAllActraiserChampions()
  pcall(function()
    ActraiserForEachChampion(boostActraiserChampion)
  end)
end

boostAllActraiserChampions()
ActraiserSuperChampionTimer = createTimer(nil, false)
ActraiserSuperChampionTimer.Interval = 100
ActraiserSuperChampionTimer.OnTimer = boostAllActraiserChampions
ActraiserSuperChampionTimer.Enabled = true

{$asm}

[DISABLE]
{$lua}
if syntaxcheck then return end

if ActraiserSuperChampionTimer then
  ActraiserSuperChampionTimer.destroy()
  ActraiserSuperChampionTimer = nil
end

if ActraiserForEachChampion and ActraiserSuperChampionOriginals then
  pcall(function()
    ActraiserForEachChampion(function(heroParam, unitParam)
      local original = ActraiserSuperChampionOriginals[heroParam]
      if not original then return end

      local unitOriginal = ActraiserSuperChampionUnitOriginals[unitParam]
      if unitOriginal and unitOriginal.hp and unitOriginal.hp &gt; 0 then
        writeSmallInteger(heroParam + 0x1E, unitOriginal.hp)
      end

      writeSmallInteger(heroParam + 0x20, original.atk)
      writeSmallInteger(heroParam + 0x22, original.def)
      writeSmallInteger(heroParam + 0x24, original.mdf)
      writeSmallInteger(heroParam + 0x30, original.resFire)
      writeSmallInteger(heroParam + 0x32, original.resIce)
      writeFloat(heroParam + 0x38, original.atkSpd)
      writeFloat(heroParam + 0x40, original.atkRng)
      writeFloat(heroParam + 0x44, original.atkAng)
      writeFloat(heroParam + 0x50, original.spAtk)
      writeFloat(heroParam + 0x54, original.spRng)
      writeFloat(heroParam + 0x58, original.spAng)
    end)
  end)
end

-- Unit parameters are long-lived datatable objects. Restore every copy touched,
-- including a prior level's object if a champion leveled up while enabled.
if ActraiserSuperChampionUnitOriginals then
  for unitParam, original in pairs(ActraiserSuperChampionUnitOriginals) do
    pcall(function()
      writeSmallInteger(unitParam + 0x18, original.hp)
      writeSmallInteger(unitParam + 0x1A, original.atk)
      writeSmallInteger(unitParam + 0x1C, original.def)
      writeSmallInteger(unitParam + 0x1E, original.mdf)
      writeSmallInteger(unitParam + 0x28, original.resFire)
      writeSmallInteger(unitParam + 0x2A, original.resIce)
      writeFloat(unitParam + 0x30, original.atkSpd)
      writeSmallInteger(unitParam + 0x36, original.atkRng)
      writeFloat(unitParam + 0x40, original.spAtk)
      writeSmallInteger(unitParam + 0x44, original.spRng)
    end)
  end
end

ActraiserSuperChampionOriginals = nil
ActraiserSuperChampionUnitOriginals = nil
ActraiserForEachChampion = nil

{$asm}
ActR_Champion_SetDamage:
  db 48 89 5C 24 08

unregistersymbol(ActR_Champion_SetDamage)
</AssemblerScript>
