        <CheatEntry>
          <ID>1</ID>
          <Description>"Infinite HP"</Description>
          <VariableType>Auto Assembler Script</VariableType>
          <AssemblerScript>[ENABLE]
// Exact unmodified CallFixedUpdate entry used to identify the live player parameter block.
aobscanmodule(ActR_HP_Capture,GameAssembly.dll,40 53 48 83 EC 60 80 3D 9A EB 27 01 00 48 8B D9 75 12 8B 0D 74 6C E3 00 E8 73 C6 D6 FF C6 05 83 EB 27 01 01)
aobscanmodule(ActR_HP_Damage,GameAssembly.dll,29 51 10 BA 00 00 00 00 8B 41 10 0F 48 C2 89 41 10 C3)
alloc(ActR_HP_Code,256,ActR_HP_Capture)
label(ActR_HP_CaptureCode)
label(ActR_HP_CaptureOriginal)
label(ActR_HP_CaptureReturn)
label(ActR_HP_DamageCode)
label(ActR_HP_NormalDamage)
label(ActR_HP_DamageReturn)
label(ActR_HP_PlayerParam)

ActR_HP_Code:
ActR_HP_CaptureCode:
  // CallFixedUpdate supplies the full object, where isPlayerble is reliable.
  cmp byte ptr [rcx+000000FD],01
  jne ActR_HP_CaptureOriginal
  mov rax,[rcx+18]
  mov [ActR_HP_PlayerParam],rax
ActR_HP_CaptureOriginal:
  push rbx
  sub rsp,60
  jmp ActR_HP_CaptureReturn

ActR_HP_DamageCode:
  // The shared damage routine supplies SVObjParamater directly.
  cmp rcx,[ActR_HP_PlayerParam]
  jne ActR_HP_NormalDamage

  // Exact player parameter block: ignore damage and refill to maximum HP.
  mov eax,[rcx+14]
  mov [rcx+10],eax
  ret

ActR_HP_NormalDamage:
  // Every non-player parameter block follows the original damage path.
  sub [rcx+10],edx
  mov edx,00000000
  jmp ActR_HP_DamageReturn

align 8
ActR_HP_PlayerParam:
  dq 0

assert(ActR_HP_Capture,40 53 48 83 EC 60)
ActR_HP_Capture:
  jmp ActR_HP_CaptureCode
  nop
ActR_HP_CaptureReturn:

assert(ActR_HP_Damage,29 51 10 BA 00 00 00 00)
ActR_HP_Damage:
  jmp ActR_HP_DamageCode
  nop 3
ActR_HP_DamageReturn:

registersymbol(ActR_HP_Capture)
registersymbol(ActR_HP_Damage)
registersymbol(ActR_HP_PlayerParam)

[DISABLE]
ActR_HP_Capture:
  db 40 53 48 83 EC 60
ActR_HP_Damage:
  db 29 51 10 BA 00 00 00 00

unregistersymbol(ActR_HP_Capture)
unregistersymbol(ActR_HP_Damage)
unregistersymbol(ActR_HP_PlayerParam)
dealloc(ActR_HP_Code)
</AssemblerScript>
