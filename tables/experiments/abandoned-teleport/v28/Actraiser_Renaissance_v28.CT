        <CheatEntry>
          <ID>21</ID>
          <Description>"Instant Champion Summon (Full Gauge)"</Description>
          <VariableType>Auto Assembler Script</VariableType>
          <AssemblerScript>[ENABLE]
aobscanmodule(ActR_Summon_SetGauge,GameAssembly.dll,40 53 48 83 EC 60 80 3D 66 1A 14 01 00 48 8B D9 0F 29 74 24 50 0F 28 F1)
aobscanmodule(ActR_Summon_Enable,GameAssembly.dll,F3 0F 10 41 2C 0F 2F 41 20 0F 93 C0 C3)
alloc(ActR_Summon_SetGaugeCode,96,ActR_Summon_SetGauge)
alloc(ActR_Summon_EnableCode,96,ActR_Summon_Enable)
label(ActR_Summon_SetGaugeReturn)

ActR_Summon_SetGaugeCode:
  // TDUIHeroSummonGauge.SetGaugeValue receives its requested value in XMM1.
  // Replace that value with GAUGE_VALUE_MAX so the original method also keeps it full.
  movss xmm1,[rcx+20]
  movss [rcx+2C],xmm1
  push rbx
  sub rsp,60
  jmp ActR_Summon_SetGaugeReturn

assert(ActR_Summon_SetGauge,40 53 48 83 EC 60)
ActR_Summon_SetGauge:
  jmp ActR_Summon_SetGaugeCode
  nop
ActR_Summon_SetGaugeReturn:

ActR_Summon_EnableCode:
  // Refresh the gauge and allow the summon button immediately.
  movss xmm0,[rcx+20]
  movss [rcx+2C],xmm0
  mov al,01
  ret

assert(ActR_Summon_Enable,F3 0F 10 41 2C)
ActR_Summon_Enable:
  jmp ActR_Summon_EnableCode

registersymbol(ActR_Summon_SetGauge)
registersymbol(ActR_Summon_Enable)

[DISABLE]
ActR_Summon_SetGauge:
  db 40 53 48 83 EC 60
ActR_Summon_Enable:
  db F3 0F 10 41 2C

unregistersymbol(ActR_Summon_SetGauge)
unregistersymbol(ActR_Summon_Enable)
dealloc(ActR_Summon_SetGaugeCode)
dealloc(ActR_Summon_EnableCode)
</AssemblerScript>
        </CheatEntry>
        <CheatEntry>
          <ID>24</ID>
          <Description>"Death Aura - Cave Monsters Only (No Sieges)"</Description>
          <VariableType>Auto Assembler Script</VariableType>
          <AssemblerScript>[ENABLE]
// CRTMonsterBase.CheckHit belongs only to the ordinary settlement cave-monster
// family. Invasion/siege attackers use the separate CRTTDMonster system.
aobscanmodule(ActR_CaveMonsterDeath,GameAssembly.dll,48 89 5C 24 20 55 48 81 EC 90 00 00 00 80 3D 81 71 33 01 00 48 8B D9 0F 29 7C 24 70 0F 29 B4 24 80 00 00 00)
alloc(ActR_CaveMonsterDeathCode,192,ActR_CaveMonsterDeath)
label(ActR_CaveMonsterDeathOriginal)
label(ActR_CaveMonsterDeathReturn)

ActR_CaveMonsterDeathCode:
  // Queue exactly the monster's remaining HP through CheckHit's native damage
  // path. The original routine then handles death, rewards, counters and cleanup.
  cmp dword ptr [rcx+000000E4],04
  je ActR_CaveMonsterDeathOriginal
  mov eax,[rcx+000000D0]
  test eax,eax
  jle ActR_CaveMonsterDeathOriginal
  mov [rcx+00000108],eax
  mov byte ptr [rcx+0000010C],01

ActR_CaveMonsterDeathOriginal:
  mov [rsp+20],rbx
  push rbp
  sub rsp,00000090
  jmp ActR_CaveMonsterDeathReturn

assert(ActR_CaveMonsterDeath,48 89 5C 24 20 55 48 81 EC 90 00 00 00)
ActR_CaveMonsterDeath:
  jmp ActR_CaveMonsterDeathCode
  nop 8
ActR_CaveMonsterDeathReturn:

registersymbol(ActR_CaveMonsterDeath)

[DISABLE]
ActR_CaveMonsterDeath:
  db 48 89 5C 24 20 55 48 81 EC 90 00 00 00

unregistersymbol(ActR_CaveMonsterDeath)
dealloc(ActR_CaveMonsterDeathCode)
</AssemblerScript>
        </CheatEntry>
      </CheatEntries>
