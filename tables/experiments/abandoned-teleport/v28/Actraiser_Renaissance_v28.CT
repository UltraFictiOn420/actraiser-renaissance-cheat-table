        <CheatEntry>
          <ID>2</ID>
          <Description>"Infinite MP"</Description>
          <VariableType>Auto Assembler Script</VariableType>
          <AssemblerScript>[ENABLE]
{$lua}
if syntaxcheck then return end

if ActraiserActMPTimer then
  ActraiserActMPTimer.destroy()
  ActraiserActMPTimer = nil
end

ActraiserResolveActPlayerReader = function()
  local root = getAddressSafe('GameAssembly.dll+16A3788')
  if not root then return nil end

  local klass = readPointer(root)
  if not klass or klass == 0 then return nil end

  local staticFields = readPointer(klass + 0xB8)
  if not staticFields or staticFields == 0 then return nil end

  local sceneAct = readPointer(staticFields + 0x50)
  if not sceneAct or sceneAct == 0 then return nil end

  local playerReader = readPointer(sceneAct + 0xC8)
  if not playerReader or playerReader == 0 then return nil end
  return playerReader
end

local function refillActraiserActMP()
  pcall(function()
    local playerReader = ActraiserResolveActPlayerReader()
    if not playerReader then return end

    -- Act Mode stores current/max MP in ExpUniValues.ExpValue objects as floats.
    local currentMP = readPointer(playerReader + 0x280)
    local maximumMP = readPointer(playerReader + 0x288)
    if not currentMP or currentMP == 0 or not maximumMP or maximumMP == 0 then return end

    local maximum = readFloat(maximumMP + 0x18)
    if maximum and maximum &gt;= 0 and maximum &lt;= 100000 then
      writeFloat(currentMP + 0x18, maximum)
      writeFloat(playerReader + 0x2C0, maximum)
    end
  end)
end

refillActraiserActMP()
ActraiserActMPTimer = createTimer(nil, false)
ActraiserActMPTimer.Interval = 50
ActraiserActMPTimer.OnTimer = refillActraiserActMP
ActraiserActMPTimer.Enabled = true

{$asm}

[DISABLE]
{$lua}
if syntaxcheck then return end

if ActraiserActMPTimer then
  ActraiserActMPTimer.destroy()
  ActraiserActMPTimer = nil
end
ActraiserResolveActPlayerReader = nil

