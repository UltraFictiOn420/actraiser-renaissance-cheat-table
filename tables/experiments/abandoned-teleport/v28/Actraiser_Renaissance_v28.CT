// ActlReadObject.CallGetDamage: hook the final integer conversion used by ordinary hits.
// The adjacent One-Hit Kill hook starts after these 12 bytes, so either toggle can load first.
aobscanmodule(ActR_ActDamage10x,GameAssembly.dll,F3 0F 2C C1 F3 0F 11 8F DC 02 00 00)
alloc(ActR_ActDamage10xCode,160,ActR_ActDamage10x)
label(ActR_ActDamage10xStore)
label(ActR_ActDamage10xReturn)

ActR_ActDamage10xCode:
  cvttss2si eax,xmm1

  // Resolve SceneAct.AcssInstance.playerReader.gameParamater at hit time.
  // Runtime inspection shows that enemies leave ParamType/uniqueID at zero,
  // so pointer identity is the reliable player/enemy discriminator.
  mov r11,[rdi+18]
  test r11,r11
  je ActR_ActDamage10xStore

  mov r10,[GameAssembly.dll+16A3788]
  test r10,r10
  je ActR_ActDamage10xStore
  mov r10,[r10+000000B8]
  test r10,r10
  je ActR_ActDamage10xStore
  mov r10,[r10+50]
  test r10,r10
  je ActR_ActDamage10xStore
  mov r10,[r10+000000C8]
  test r10,r10
  je ActR_ActDamage10xStore
  mov r10,[r10+18]
  test r10,r10
  je ActR_ActDamage10xStore
  cmp r11,r10
  je ActR_ActDamage10xStore
  test eax,eax
  jle ActR_ActDamage10xStore
  imul eax,eax,0A

ActR_ActDamage10xStore:
  movss [rdi+000002DC],xmm1
  jmp ActR_ActDamage10xReturn

assert(ActR_ActDamage10x,F3 0F 2C C1 F3 0F 11 8F DC 02 00 00)
ActR_ActDamage10x:
  jmp ActR_ActDamage10xCode
  nop 7
ActR_ActDamage10xReturn:

registersymbol(ActR_ActDamage10x)

[DISABLE]
