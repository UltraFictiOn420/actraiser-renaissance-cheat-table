        <CheatEntry>
          <ID>7</ID>
          <Description>"Angel SP Value = 90"</Description>
          <VariableType>Auto Assembler Script</VariableType>
          <AssemblerScript>[ENABLE]
aobscanmodule(ActR_AngelSP_UISet,GameAssembly.dll,48 83 EC 38 4C 8B 51 50 45 84 C0 74 2D 48 8B 81 A8 00 00 00 48 85 C0 74 48 83 78 18 01 76 48)
alloc(ActR_AngelSP_UISetCode,64,ActR_AngelSP_UISet)
label(ActR_AngelSP_UISetReturn)

ActR_AngelSP_UISetCode:
  // CRTUI.SetSp: keep the visible HUD value synchronized with the 90-SP toggle.
  mov edx,0000005A
  sub rsp,38
  mov r10,[rcx+50]
  jmp ActR_AngelSP_UISetReturn

assert(ActR_AngelSP_UISet,48 83 EC 38 4C 8B 51 50)
ActR_AngelSP_UISet:
  jmp ActR_AngelSP_UISetCode
  nop 3
ActR_AngelSP_UISetReturn:

registersymbol(ActR_AngelSP_UISet)

{$lua}
if syntaxcheck then return end

if ActraiserAngelSP90Timer then
  ActraiserAngelSP90Timer.destroy()
  ActraiserAngelSP90Timer = nil
end

ActraiserResolveAngelSP90 = function()
  local root = getAddressSafe('GameAssembly.dll+16A34B0')
  if not root then return nil end

  local klass = readPointer(root)
  if not klass or klass == 0 then return nil end

  local staticFields = readPointer(klass + 0xB8)
  if not staticFields or staticFields == 0 then return nil end

  local manager = readPointer(staticFields)
  if not manager or manager == 0 then return nil end

  local saveData = readPointer(manager + 0x30)
  if not saveData or saveData == 0 then return nil end

  return saveData + 0x60
end

local function setActraiserAngelSP90()
  local address = ActraiserResolveAngelSP90()
  if not address then return end

  if ActraiserAngelSP90Address ~= address then
    ActraiserAngelSP90Address = address
    ActraiserAngelSP90Original = readInteger(address)
  end

  writeInteger(address, 90)
end

ActraiserAngelSP90Address = nil
ActraiserAngelSP90Original = nil
setActraiserAngelSP90()

ActraiserAngelSP90Timer = createTimer(nil, false)
ActraiserAngelSP90Timer.Interval = 100
ActraiserAngelSP90Timer.OnTimer = setActraiserAngelSP90
ActraiserAngelSP90Timer.Enabled = true

{$asm}

[DISABLE]
{$lua}
if syntaxcheck then return end

if ActraiserAngelSP90Timer then
  ActraiserAngelSP90Timer.destroy()
  ActraiserAngelSP90Timer = nil
end

local currentAddress = nil
if ActraiserResolveAngelSP90 then
  currentAddress = ActraiserResolveAngelSP90()
end

if currentAddress and currentAddress == ActraiserAngelSP90Address and ActraiserAngelSP90Original ~= nil then
  writeInteger(currentAddress, ActraiserAngelSP90Original)
end

ActraiserAngelSP90Address = nil
ActraiserAngelSP90Original = nil
ActraiserResolveAngelSP90 = nil

{$asm}
ActR_AngelSP_UISet:
  db 48 83 EC 38 4C 8B 51 50

unregistersymbol(ActR_AngelSP_UISet)
dealloc(ActR_AngelSP_UISetCode)
