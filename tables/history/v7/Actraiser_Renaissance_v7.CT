        <CheatEntry>
          <ID>8</ID>
          <Description>"Max Realm Resources (999)"</Description>
          <VariableType>Auto Assembler Script</VariableType>
          <AssemblerScript>[ENABLE]
aobscanmodule(ActR_RealmMaterial_UISet,GameAssembly.dll,48 83 EC 38 45 84 C0 75 20 48 8B 49 78 48 85 C9 74 1C 48 63 D2 45 33 C9 0F 57 D2 48 C7 44 24 20 00 00 00 00)
alloc(ActR_RealmMaterial_UISetCode,64,ActR_RealmMaterial_UISet)
label(ActR_RealmMaterial_UISetReturn)

ActR_RealmMaterial_UISetCode:
  // CRTUI.SetMaterial: synchronize the visible realm-resource counter.
  mov edx,000003E7
  sub rsp,38
  test r8b,r8b
  jmp ActR_RealmMaterial_UISetReturn

assert(ActR_RealmMaterial_UISet,48 83 EC 38 45 84 C0)
ActR_RealmMaterial_UISet:
  jmp ActR_RealmMaterial_UISetCode
  nop 2
ActR_RealmMaterial_UISetReturn:

registersymbol(ActR_RealmMaterial_UISet)

{$lua}
if syntaxcheck then return end

if ActraiserRealmMaterialTimer then
  ActraiserRealmMaterialTimer.destroy()
  ActraiserRealmMaterialTimer = nil
end

ActraiserResolveRealmMaterial = function()
  local root = getAddressSafe('GameAssembly.dll+16A34B0')
  if not root then return nil end

  local klass = readPointer(root)
  if not klass or klass == 0 then return nil end

  local staticFields = readPointer(klass + 0xB8)
  if not staticFields or staticFields == 0 then return nil end

  local manager = readPointer(staticFields)
  if not manager or manager == 0 then return nil end

  local saveData = readPointer(manager + 0x30)
  if not saveData or saveData == 0 then return nil end

  local area = readInteger(saveData + 0x2C)
  local crtDataArray = readPointer(saveData + 0x138)
  if not area or area &lt; 0 or not crtDataArray or crtDataArray == 0 then return nil end

  local areaCount = readInteger(crtDataArray + 0x18)
  if not areaCount or area &gt;= areaCount then return nil end

  local crtData = readPointer(crtDataArray + 0x20 + area * 8)
  if not crtData or crtData == 0 then return nil end

  local stageParameter = readPointer(crtData + 0x28)
  if not stageParameter or stageParameter == 0 then return nil end

  return stageParameter + 0x10
end

local function setActraiserRealmMaterial999()
  local address = ActraiserResolveRealmMaterial()
  if not address then return end

  if ActraiserRealmMaterialOriginals[address] == nil then
    ActraiserRealmMaterialOriginals[address] = readInteger(address)
  end

  writeInteger(address, 999)
end

ActraiserRealmMaterialOriginals = {}
setActraiserRealmMaterial999()

ActraiserRealmMaterialTimer = createTimer(nil, false)
ActraiserRealmMaterialTimer.Interval = 100
ActraiserRealmMaterialTimer.OnTimer = setActraiserRealmMaterial999
ActraiserRealmMaterialTimer.Enabled = true

{$asm}

[DISABLE]
{$lua}
if syntaxcheck then return end

if ActraiserRealmMaterialTimer then
  ActraiserRealmMaterialTimer.destroy()
  ActraiserRealmMaterialTimer = nil
end

if ActraiserRealmMaterialOriginals then
  for address, original in pairs(ActraiserRealmMaterialOriginals) do
    pcall(writeInteger, address, original)
  end
end

ActraiserRealmMaterialOriginals = nil
ActraiserResolveRealmMaterial = nil

{$asm}
ActR_RealmMaterial_UISet:
  db 48 83 EC 38 45 84 C0

unregistersymbol(ActR_RealmMaterial_UISet)
dealloc(ActR_RealmMaterial_UISetCode)
</AssemblerScript>
