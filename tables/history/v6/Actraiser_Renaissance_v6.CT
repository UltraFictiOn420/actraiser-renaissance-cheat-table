<?xml version="1.0" encoding="utf-8"?>
<CheatTable CheatEngineTableVersion="46">
  <CheatEntries>
    <CheatEntry>
      <ID>0</ID>
      <Description>"Act Mode / Side-Scroller"</Description>
      <Options moHideChildren="1"/>
      <GroupHeader>1</GroupHeader>
      <CheatEntries>
        <CheatEntry>
          <ID>1</ID>
          <Description>"Infinite HP"</Description>
          <VariableType>Auto Assembler Script</VariableType>
          <AssemblerScript>[ENABLE]
aobscanmodule(ActR_HP_Capture,GameAssembly.dll,40 53 48 83 EC 60 80 3D 9A EB 27 01 00 48 8B D9 75 12 8B 0D 74 6C E3 00 E8 73 C6 D6 FF C6 05 83 EB 27 01 01)
aobscanmodule(ActR_HP_Damage,GameAssembly.dll,29 51 10 BA 00 00 00 00 8B 41 10 0F 48 C2 89 41 10 C3)
alloc(ActR_HP_Code,256,ActR_HP_Capture)
label(ActR_HP_CaptureCode)
label(ActR_HP_CaptureOriginal)
label(ActR_HP_CaptureReturn)
label(ActR_HP_DamageCode)
label(ActR_HP_NormalDamage)
label(ActR_HP_DamageReturn)
label(ActR_HP_PlayerParam)

ActR_HP_Code:
ActR_HP_CaptureCode:
  // CallFixedUpdate supplies the full object, where isPlayerble is reliable.
  cmp byte ptr [rcx+000000FD],01
  jne ActR_HP_CaptureOriginal
  mov rax,[rcx+18]
  mov [ActR_HP_PlayerParam],rax
ActR_HP_CaptureOriginal:
  push rbx
  sub rsp,60
  jmp ActR_HP_CaptureReturn

ActR_HP_DamageCode:
  // The shared damage routine supplies SVObjParamater directly.
  cmp rcx,[ActR_HP_PlayerParam]
  jne ActR_HP_NormalDamage

  // Exact player parameter block: ignore damage and refill to maximum HP.
  mov eax,[rcx+14]
  mov [rcx+10],eax
  ret

ActR_HP_NormalDamage:
  // Every non-player parameter block follows the original damage path.
  sub [rcx+10],edx
  mov edx,00000000
  jmp ActR_HP_DamageReturn

align 8
ActR_HP_PlayerParam:
  dq 0

assert(ActR_HP_Capture,40 53 48 83 EC 60)
ActR_HP_Capture:
  jmp ActR_HP_CaptureCode
  nop
ActR_HP_CaptureReturn:

assert(ActR_HP_Damage,29 51 10 BA 00 00 00 00)
ActR_HP_Damage:
  jmp ActR_HP_DamageCode
  nop 3
ActR_HP_DamageReturn:

registersymbol(ActR_HP_Capture)
registersymbol(ActR_HP_Damage)
registersymbol(ActR_HP_PlayerParam)

[DISABLE]
ActR_HP_Capture:
  db 40 53 48 83 EC 60
ActR_HP_Damage:
  db 29 51 10 BA 00 00 00 00

unregistersymbol(ActR_HP_Capture)
unregistersymbol(ActR_HP_Damage)
unregistersymbol(ActR_HP_PlayerParam)
dealloc(ActR_HP_Code)
</AssemblerScript>
        </CheatEntry>
        <CheatEntry>
          <ID>2</ID>
          <Description>"Infinite MP"</Description>
          <VariableType>Auto Assembler Script</VariableType>
          <AssemblerScript>[ENABLE]
aobscanmodule(ActR_MP_Get,GameAssembly.dll,48 83 EC 28 80 B9 6C 02 00 00 00 74 16 48 8B 81 80 02 00 00 48 85 C0 74 11 F3 0F 2C 40 18 48 83 C4 28 C3)
aobscanmodule(ActR_MP_Set,GameAssembly.dll,48 8B 81 80 02 00 00 48 85 C0 74 19 66 0F 6E C2 0F 5B C0 F3 0F 11 40 18 F3 0F 11 81 C0 02 00 00)
alloc(ActR_MP_Code,128,ActR_MP_Set)
label(ActR_MP_Convert)
label(ActR_MP_Return)

ActR_MP_Code:
  mov r11,[rcx+00000288]
  test r11,r11
  je ActR_MP_Convert
  cvttss2si edx,[r11+18]
ActR_MP_Convert:
  movd xmm0,edx
  cvtdq2ps xmm0,xmm0
  jmp ActR_MP_Return

assert(ActR_MP_Get+10,80)
assert(ActR_MP_Set+0C,66 0F 6E C2 0F 5B C0)

// Read maximum MP in place of current MP.
ActR_MP_Get+10:
  db 88

// Force every attempted MP change to use maximum MP.
ActR_MP_Set+0C:
  jmp ActR_MP_Code
  nop 2
ActR_MP_Return:

registersymbol(ActR_MP_Get)
registersymbol(ActR_MP_Set)

[DISABLE]
assert(ActR_MP_Get+10,88)

ActR_MP_Get+10:
  db 80
ActR_MP_Set+0C:
  db 66 0F 6E C2 0F 5B C0

unregistersymbol(ActR_MP_Get)
unregistersymbol(ActR_MP_Set)
dealloc(ActR_MP_Code)
</AssemblerScript>
        </CheatEntry>
        <CheatEntry>
          <ID>3</ID>
          <Description>"Infinite Lives"</Description>
          <VariableType>Auto Assembler Script</VariableType>
          <AssemblerScript>[ENABLE]
{$lua}
if syntaxcheck then return end

if ActraiserLivesTimer then
  ActraiserLivesTimer.destroy()
  ActraiserLivesTimer = nil
end

local function resolveActraiserLivesUsed()
  local root = getAddressSafe('GameAssembly.dll+16A34B0')
  if not root then return nil end

  local klass = readPointer(root)
  if not klass or klass == 0 then return nil end

  local staticFields = readPointer(klass + 0xB8)
  if not staticFields or staticFields == 0 then return nil end

  local manager = readPointer(staticFields)
  if not manager or manager == 0 then return nil end

  local saveData = readPointer(manager + 0x30)
  if not saveData or saveData == 0 then return nil end

  return saveData + 0x34
end

local function refillActraiserLives()
  local address = resolveActraiserLivesUsed()
  if address then writeInteger(address, 0) end
end

refillActraiserLives()
ActraiserLivesTimer = createTimer(nil, false)
ActraiserLivesTimer.Interval = 100
ActraiserLivesTimer.OnTimer = refillActraiserLives
ActraiserLivesTimer.Enabled = true

{$asm}

[DISABLE]
{$lua}
if syntaxcheck then return end

if ActraiserLivesTimer then
  ActraiserLivesTimer.destroy()
  ActraiserLivesTimer = nil
end

{$asm}
</AssemblerScript>
        </CheatEntry>
      </CheatEntries>
    </CheatEntry>
    <CheatEntry>
      <ID>4</ID>
      <Description>"Settlement / Angel Mode"</Description>
      <Options moHideChildren="1"/>
      <GroupHeader>1</GroupHeader>
      <CheatEntries>
        <CheatEntry>
          <ID>5</ID>
          <Description>"Infinite Angel HP"</Description>
          <VariableType>Auto Assembler Script</VariableType>
          <AssemblerScript>[ENABLE]
aobscanmodule(ActR_AngelHP_Setter,GameAssembly.dll,40 53 48 83 EC 20 80 3D 0F EB 74 00 00 8B DA 75 12 8B 0D AD CF 2A 00 E8 F4 EB 22 FF C6 05 F9 EA 74 00 01)
alloc(ActR_AngelHP_Code,128,ActR_AngelHP_Setter)
label(ActR_AngelHP_Return)

ActR_AngelHP_Code:
  // CRTAngel.set_nowHp: force every requested HP value to the angel's maxHp.
  mov edx,[rcx+000001C4]
  push rbx
  sub rsp,20
  jmp ActR_AngelHP_Return

assert(ActR_AngelHP_Setter,40 53 48 83 EC 20)
ActR_AngelHP_Setter:
  jmp ActR_AngelHP_Code
  nop
ActR_AngelHP_Return:

registersymbol(ActR_AngelHP_Setter)

[DISABLE]
ActR_AngelHP_Setter:
  db 40 53 48 83 EC 20

unregistersymbol(ActR_AngelHP_Setter)
dealloc(ActR_AngelHP_Code)
</AssemblerScript>
        </CheatEntry>
        <CheatEntry>
          <ID>6</ID>
          <Description>"Infinite Angel SP"</Description>
          <VariableType>Auto Assembler Script</VariableType>
          <AssemblerScript>[ENABLE]
aobscanmodule(ActR_AngelSP_Setter,GameAssembly.dll,40 53 48 83 EC 20 80 3D 51 EA 74 00 00 8B DA 75 12 8B 0D F5 CE 2A 00 E8 34 EB 22 FF C6 05 3B EA 74 00 01)
alloc(ActR_AngelSP_Code,128,ActR_AngelSP_Setter)
label(ActR_AngelSP_Return)

ActR_AngelSP_Code:
  // CRTAngel.set_nowSp: force every requested SP value to the angel's maxSp.
  mov edx,[rcx+000001C8]
  push rbx
  sub rsp,20
  jmp ActR_AngelSP_Return

assert(ActR_AngelSP_Setter,40 53 48 83 EC 20)
ActR_AngelSP_Setter:
  jmp ActR_AngelSP_Code
  nop
ActR_AngelSP_Return:

registersymbol(ActR_AngelSP_Setter)

[DISABLE]
ActR_AngelSP_Setter:
  db 40 53 48 83 EC 20

unregistersymbol(ActR_AngelSP_Setter)
dealloc(ActR_AngelSP_Code)
</AssemblerScript>
        </CheatEntry>
        <CheatEntry>
          <ID>7</ID>
          <Description>"Angel SP Value = 90"</Description>
          <VariableType>Auto Assembler Script</VariableType>
          <AssemblerScript>[ENABLE]
{$lua}
if syntaxcheck then return end

if ActraiserAngelSP90Timer then
  ActraiserAngelSP90Timer.destroy()
  ActraiserAngelSP90Timer = nil
end

ActraiserResolveAngelSP90 = function()
  local root = getAddressSafe('GameAssembly.dll+16A34B0')
  if not root then return nil end

  local klass = readPointer(root)
  if not klass or klass == 0 then return nil end

  local staticFields = readPointer(klass + 0xB8)
  if not staticFields or staticFields == 0 then return nil end

  local manager = readPointer(staticFields)
  if not manager or manager == 0 then return nil end

  local saveData = readPointer(manager + 0x30)
  if not saveData or saveData == 0 then return nil end

  return saveData + 0x60
end

local function setActraiserAngelSP90()
  local address = ActraiserResolveAngelSP90()
  if not address then return end

  if ActraiserAngelSP90Address ~= address then
    ActraiserAngelSP90Address = address
    ActraiserAngelSP90Original = readInteger(address)
  end

  writeInteger(address, 90)
end

ActraiserAngelSP90Address = nil
ActraiserAngelSP90Original = nil
setActraiserAngelSP90()

ActraiserAngelSP90Timer = createTimer(nil, false)
ActraiserAngelSP90Timer.Interval = 100
ActraiserAngelSP90Timer.OnTimer = setActraiserAngelSP90
ActraiserAngelSP90Timer.Enabled = true

{$asm}

[DISABLE]
{$lua}
if syntaxcheck then return end

if ActraiserAngelSP90Timer then
  ActraiserAngelSP90Timer.destroy()
  ActraiserAngelSP90Timer = nil
end

local currentAddress = nil
if ActraiserResolveAngelSP90 then
  currentAddress = ActraiserResolveAngelSP90()
end

if currentAddress and currentAddress == ActraiserAngelSP90Address and ActraiserAngelSP90Original ~= nil then
  writeInteger(currentAddress, ActraiserAngelSP90Original)
end

ActraiserAngelSP90Address = nil
ActraiserAngelSP90Original = nil
ActraiserResolveAngelSP90 = nil

{$asm}
</AssemblerScript>
        </CheatEntry>
      </CheatEntries>
    </CheatEntry>
  </CheatEntries>
  <UserdefinedSymbols/>
  <Comments>Actraiser Renaissance (Steam/PC)
Includes separate script groups for Act Mode / side-scroller gameplay and Settlement / Angel Mode.

Act Mode Infinite HP captures the exact live player parameter-block pointer during ActlReadObject.CallFixedUpdate, then filters the authoritative shared SVObjParamater.Damage routine by pointer identity. Infinite MP uses unique GameAssembly.dll AOB signatures derived from the game's IL2CPP MP accessors. Infinite Lives keeps SaveData.actContinueCnt (continues used) at zero; zero corresponds to the displayed three lives.

Settlement / Angel Mode Infinite HP and Infinite SP hook the angel-specific CRTAngel setters and replace attempted changes with the live maxHp or maxSp field. Angel SP Value = 90 keeps the angel's current SP at 90 while enabled and restores its previous value when disabled. It is compatible with Infinite Angel SP. These scripts do not touch enemy or Act Mode health routines.

Attach Cheat Engine to ActraiserR.exe, expand the group, and activate entries individually.</Comments>
</CheatTable>
